<Window x:Class="Tk2Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wintec TK2 変換ツール - NMEA / Google Earth (KMZ)" Height="680" Width="980" MinHeight="520" MinWidth="820"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI" FontSize="13" Icon="AppIcon.ico">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="130"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- ツールバー -->
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Name="AddFilesButton" Content="ファイルを追加..." Click="AddFiles_Click"/>
            <Button Name="AddFolderButton" Content="フォルダを追加..." Click="AddFolder_Click"/>
            <Button Name="RemoveButton" Content="選択を削除" Click="Remove_Click"/>
            <Button Name="ClearButton" Content="すべてクリア" Click="Clear_Click"/>
            <Button Name="CourseButton" Content="コース定義を作成..." Click="Course_Click" Margin="14,0,6,0"/>
            <Button Name="LapButton" Content="ラップ解析..." Click="Lap_Click"/>
            <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                       Text="※ .tk2 ファイルやフォルダをこの画面へドラッグ＆ドロップでも追加できます"/>
        </StackPanel>

        <!-- 左: ファイル一覧と要約 -->
        <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="140"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <DataGrid Name="FileGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" SelectionChanged="FileGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ファイル" Binding="{Binding Name}" IsReadOnly="True" Width="170"/>
                        <DataGridTextColumn Header="記録範囲 (現地時刻)" Binding="{Binding Range}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="開始カット" Binding="{Binding Start, UpdateSourceTrigger=LostFocus}" Width="80"/>
                        <DataGridTextColumn Header="終了カット" Binding="{Binding End, UpdateSourceTrigger=LostFocus}" Width="80"/>
                        <DataGridTextColumn Header="状態" Binding="{Binding Status}" IsReadOnly="True" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="16" TextAlignment="Center"
                           Text="ここに .tk2 ファイルまたはフォルダを&#x0A;ドラッグ＆ドロップしてください"/>
            </Grid>

            <TextBlock Grid.Row="1" Margin="0,4,0,6" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Text="前後をカットしたいときは「開始カット」「終了カット」に現地時刻を入力 (例 08:05:00)。空欄ならカットしません。"/>

            <GroupBox Grid.Row="2" Header="選択中のファイルの記録と停止区間 (60 秒以上記録なし)" Margin="0">
                <TextBox Name="SummaryBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         FontFamily="Consolas, MS Gothic" VerticalScrollBarVisibility="Auto"/>
            </GroupBox>
        </Grid>

        <!-- 右: 設定 -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="出力先">
                    <StackPanel>
                        <RadioButton Name="OutSameRadio" Content="各 .tk2 と同じフォルダ" IsChecked="True" Margin="0,0,0,4"/>
                        <RadioButton Name="OutCustomRadio" Content="フォルダを指定" Margin="0,0,0,4"/>
                        <DockPanel IsEnabled="{Binding IsChecked, ElementName=OutCustomRadio}">
                            <Button DockPanel.Dock="Right" Content="参照..." Margin="6,0,0,0" Click="BrowseOut_Click"/>
                            <TextBox Name="OutDirBox"/>
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="出力形式">
                    <StackPanel>
                        <TextBlock Text="NMEA (.nmea) は常に出力します" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Google Earth 用: " VerticalAlignment="Center"/>
                            <ComboBox Name="KmlCombo" SelectedIndex="0">
                                <ComboBoxItem Content="KMZ (推奨)"/>
                                <ComboBoxItem Content="KML (凡例画像なし)"/>
                                <ComboBoxItem Content="出力しない (NMEA のみ)"/>
                            </ComboBox>
                        </DockPanel>
                        <CheckBox Name="LocalDateCheck" Content="RMC の日付を日本時間の日付にする"
                                  ToolTip="既定は NMEA 規格どおり UTC の日付です"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Google Earth の表示">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="高さ: " VerticalAlignment="Center"/>
                            <ComboBox Name="AltCombo">
                                <ComboBoxItem Content="GPS の高度 (橋・高架も再現)"/>
                                <ComboBoxItem Content="地表に沿わせる"/>
                            </ComboBox>
                        </DockPanel>
                        <CheckBox Name="TourCheck" Content="走行アニメーション (ツアー) を作る"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="GPS 週番号の補正">
                    <DockPanel>
                        <TextBlock Text="補正する週数: " VerticalAlignment="Center"/>
                        <TextBox Name="WeeksBox" Width="60" HorizontalAlignment="Left"
                                 ToolTip="空欄 = 自動 (通常 1024 週)。0 で補正なし"/>
                        <TextBlock Text="  空欄 = 自動" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </DockPanel>
                </GroupBox>

                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                           Text="上記以外の細かい設定 (Km ポスト、速度の色分け、ツアーのカメラなど) は exe と同じフォルダの tk2nmea.ini で変更できます。初期値にも ini の内容が反映されます。"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 実行 -->
        <DockPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,8">
            <Button Name="ConvertButton" DockPanel.Dock="Left" Content="変換する" FontWeight="Bold" Padding="26,8"
                    Click="Convert_Click" IsEnabled="False"/>
            <Button Name="OpenOutButton" DockPanel.Dock="Left" Content="出力フォルダを開く" Padding="12,8"
                    Click="OpenOut_Click" IsEnabled="False"/>
            <TextBlock Name="StatusText" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource OkBrush}" FontWeight="Bold"
                       Text="ファイルを追加してください"/>
        </DockPanel>

        <!-- ログ -->
        <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Name="LogBox" IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas, MS Gothic" FontSize="12" TextWrapping="NoWrap"/>
    </Grid>
</Window>
