<Window x:Class="Tk2Gui.EngineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="回転数・アクセルの解析" Height="640" Width="1280" MinHeight="400" MinWidth="700"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI" FontSize="13" Icon="AppIcon.ico">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Name="SummaryText" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <WrapPanel Grid.Row="1" Margin="0,0,0,6">
            <StackPanel Name="CoefPanel" Orientation="Horizontal">
                <TextBlock Text="回転数 / 速度" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Name="CoefBox" Width="70" VerticalAlignment="Center"/>
                <TextBlock Text="rpm / (km/h)" VerticalAlignment="Center" Margin="4,0,8,0"/>
                <Button Content="この値で保存" Padding="10,3" Margin="0,0,6,0" Click="SaveCoef_Click"
                        ToolTip="直結なので 回転数 = この値 × 速度。音から求めた値が合わないときに手で直します (図の水色の線がこの値で描いた倍音です)"/>
                <Button Content="音から求めた値に戻す" Padding="10,3" Margin="0,0,14,0" Click="ResetCoef_Click"/>
            </StackPanel>
            <StackPanel Name="GearPanel" Orientation="Horizontal" Visibility="Collapsed">
                <TextBlock Text="ギア比" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox Name="GearsBox" Width="210" VerticalAlignment="Center" ToolTip="1 速から順に、カンマで区切って (例: 3.266, 2.130, 1.517)"/>
                <TextBlock Text="使うのは" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <TextBox Name="MaxGearBox" Width="26" VerticalAlignment="Center" ToolTip="使う一番上のギア。0 なら解析のときに音から自動で決めます (決まった値がここに入ります)。ギアの判定と音の線のたどり方に使います (変えたら解析し直すとよりよくなります)"/>
                <TextBlock Text="速まで" VerticalAlignment="Center" Margin="4,0,0,0"/>
                <TextBlock Text="最終" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <TextBox Name="FinalBox" Width="50" VerticalAlignment="Center"/>
                <TextBlock Text="タイヤ" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <TextBox Name="TireBox" Width="80" VerticalAlignment="Center" ToolTip="215/45R17 の形。走っているときの 1 周は表記の 97 % として計算します"/>
                <TextBlock Text="1 周" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <TextBox Name="CircBox" Width="50" VerticalAlignment="Center" ToolTip="走っているときのタイヤ 1 周 [m]。0 ならタイヤのサイズから"/>
                <TextBlock Text="m  気筒" VerticalAlignment="Center" Margin="4,0,4,0"/>
                <TextBox Name="CylBox" Width="30" VerticalAlignment="Center" ToolTip="4 ストの気筒数 (1 回転の爆発 = 気筒数 / 2)。変えたら解析し直してください"/>
                <TextBlock Text="目盛り 最高 / 黄 / 赤" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <TextBox Name="TachoBox" Width="120" VerticalAlignment="Center" ToolTip="回転計の目盛り [rpm] (例: 9000, 7500, 8200)"/>
                <Button Content="保存" Padding="10,3" Margin="8,0,14,0" Click="SaveCar_Click"
                        ToolTip="ギアの判定と回転計の目盛りに使います (解析し直す必要はありません。気筒数を変えたときだけ解析し直し)"/>
            </StackPanel>
            <TextBlock Text="横の拡大" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Name="ZoomCombo" Width="70" SelectedIndex="1" SelectionChanged="Zoom_Changed">
                <ComboBoxItem Content="50 %" Tag="0.5"/>
                <ComboBoxItem Content="100 %" Tag="1"/>
                <ComboBoxItem Content="200 %" Tag="2"/>
            </ComboBox>
        </WrapPanel>
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Auto" Background="Black">
            <Image Name="SpecImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        </ScrollViewer>
        <TextBlock Grid.Row="3" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                   Name="LegendText" Text="図: 横 = 時間 (白い目盛りは 10 秒ごと)、縦 = 周波数 (0〜1200 Hz、黄色の目盛りは 100 Hz ごと)。明るい線がエンジン音の倍音です。水色 = 係数 × 速度 から計算した倍音 (1・2・4 倍)、赤 = 音から求めた回転数の倍音。下の帯 = アクセル (緑 = ON、灰 = OFF、黒 = 不明)。水色と明るい線が重なっていれば、係数は合っています。"/>
    </Grid>
</Window>
