<Window x:Class="Tk2Gui.VideoCompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="動画で比較" Height="700" Width="1500" MinHeight="420" MinWidth="900"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI" FontSize="13" Icon="AppIcon.ico">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 2 つの動画 (横並び / 縦並び) -->
        <Grid Name="PaneGrid" Grid.Row="0"/>

        <!-- 再生の操作 -->
        <WrapPanel Grid.Row="1" Margin="0,8,0,0">
            <Button Content="⏮" Padding="10,4" Margin="0,0,4,4" Click="Restart_Click" ToolTip="最初から"/>
            <Button Content="−1 秒" Tag="-1" Padding="8,4" Margin="0,0,4,4" Click="Step_Click"/>
            <Button Content="◀ コマ" Tag="-f" Padding="8,4" Margin="0,0,4,4" Click="Step_Click" ToolTip="1 コマ戻す (← キー)"/>
            <Button Name="PlayButton" Content="▶ 再生" Width="90" Padding="0,4" Margin="0,0,4,4" Click="Play_Click" ToolTip="再生・一時停止 (スペース キー)"/>
            <Button Content="コマ ▶" Tag="f" Padding="8,4" Margin="0,0,4,4" Click="Step_Click" ToolTip="1 コマ進める (→ キー)"/>
            <Button Content="＋1 秒" Tag="1" Padding="8,4" Margin="0,0,14,4" Click="Step_Click"/>
            <TextBlock Text="速度" VerticalAlignment="Center" Margin="0,0,6,4"/>
            <ComboBox Name="SpeedCombo" Width="80" SelectedIndex="3" Margin="0,0,14,4" SelectionChanged="Speed_Changed"
                      ToolTip="1 × 以外では音声は出ません">
                <ComboBoxItem Content="0.1 ×" Tag="0.1"/>
                <ComboBoxItem Content="0.25 ×" Tag="0.25"/>
                <ComboBoxItem Content="0.5 ×" Tag="0.5"/>
                <ComboBoxItem Content="1 ×" Tag="1"/>
                <ComboBoxItem Content="2 ×" Tag="2"/>
            </ComboBox>
            <TextBlock Text="揃える位置" VerticalAlignment="Center" Margin="0,0,6,4"/>
            <ComboBox Name="AlignCombo" Width="150" Margin="0,0,14,4"
                      ToolTip="2 つの映像をどこで揃えて再生するか。セクターの開始を選ぶと、両方がそのセクターに入った瞬間を 0 秒にして再生します (⏮ と繰り返しもそこから)。地図も同じように揃えます"/>
            <TextBlock Text="音声" VerticalAlignment="Center" Margin="0,0,6,4"/>
            <ComboBox Name="AudioCombo" Width="190" SelectedIndex="0" Margin="0,0,14,4" SelectionChanged="Audio_Changed"
                      ToolTip="どちらの音を聞くか (1 キー = A、2 キー = B、3 キー = 両方、4 キー = 左右に分ける、0 キー = なし)。左右に分けると、A の音をモノラルにして左のスピーカー、B の音を右のスピーカーから出します">
                <ComboBoxItem Content="両方"/>
                <ComboBoxItem Content="A だけ"/>
                <ComboBoxItem Content="B だけ"/>
                <ComboBoxItem Content="なし"/>
                <ComboBoxItem Content="左右に分ける (A = 左, B = 右)"/>
            </ComboBox>
            <TextBlock Text="並べ方" VerticalAlignment="Center" Margin="0,0,6,4"/>
            <ComboBox Name="LayoutCombo" Width="80" SelectedIndex="0" Margin="0,0,14,4" SelectionChanged="Layout_Changed">
                <ComboBoxItem Content="左右"/>
                <ComboBoxItem Content="上下"/>
            </ComboBox>
            <CheckBox Name="OverlayCheck" Content="速度・タイム・セクターを重ねる" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,4"
                      Checked="Overlay_Changed" Unchecked="Overlay_Changed" ToolTip="動画素材の書き出しと同じ表示 (同じレイアウトの設定) を、それぞれの映像に重ねます"/>
            <CheckBox Name="GraphCheck" Content="速度のグラフ" VerticalAlignment="Center" Margin="0,0,14,4"
                      ToolTip="右下のセクター表示の上に、距離ごとの速度のグラフを出します。動画素材の書き出し・走行動画の時刻合わせと共通の設定です (どこかで変えるとほかの画面にも反映)"/>
            <CheckBox Name="LoopCheck" Content="繰り返す" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,4"/>
            <Button Content="地図 (航空写真) を開く" Padding="10,4" Margin="0,0,4,4" Click="Map_Click"
                    ToolTip="2 台の位置を航空写真の上で比べる画面を開きます (この画面の再生と一緒に動きます)"/>
            <Button Content="並べて配置" Padding="10,4" Margin="0,0,0,4" Click="Arrange_Click"
                    ToolTip="この画面を上に大きく、ラップ・セクタータイムを左下、地図を右下に並べます (この画面があるモニターに合わせます。地図が開いていなければ開きます)"/>
        </WrapPanel>
        <DockPanel Grid.Row="2" Margin="0,2,0,0">
            <TextBlock Name="TimeText" DockPanel.Dock="Right" Width="200" TextAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas"/>
            <Slider Name="TimeSlider" Minimum="0" Maximum="1" ValueChanged="Slider_Changed" IsMoveToPointEnabled="True" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock Name="StatusText" Grid.Row="3" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
    </Grid>
</Window>
