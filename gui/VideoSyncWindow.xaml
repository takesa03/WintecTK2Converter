<Window x:Class="Tk2Gui.VideoSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="走行動画の時刻合わせ・切り出し" Height="780" Width="1280" MinHeight="520" MinWidth="900"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI" FontSize="13" Icon="AppIcon.ico">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- 動画の選択 -->
        <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,6">
            <TextBlock Text="動画" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <Button DockPanel.Dock="Right" Content="開く..." Padding="10,3" Margin="6,0,0,0" Click="Browse_Click"/>
            <ComboBox Name="VideoCombo" SelectionChanged="Video_Changed"
                      ToolTip="このログに時刻合わせした動画 (切り出した動画を含む)。新しい動画は「開く...」から"/>
        </DockPanel>

        <!-- 映像 -->
        <Border Grid.Row="1" Grid.Column="0" CornerRadius="4" ClipToBounds="True">
            <Grid Name="PaneHost"/>
        </Border>

        <!-- 右側: 周回・時刻合わせ・切り出し -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Name="LapHeader" Text="周回 (Ctrl / Shift で複数選択)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ListBox Name="LapList" Height="220" SelectionMode="Extended" FontFamily="Consolas" MouseDoubleClick="LapList_DoubleClick"
                         ToolTip="ダブルクリックで、その周回の開始 (ラインの通過) の所へ移動します"/>

                <GroupBox Header="時刻合わせ" Margin="0,10,0,0">
                    <StackPanel Margin="4">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6"
                                   Name="SyncHelp"
                                   Text="1. 周回を 1 つ選びます。&#x0A;2. 動画をコマ送りして、その周回の開始 (コントロールラインを通った瞬間) のコマを出します。&#x0A;3. 「このコマが選んだ周回の開始」を押します。&#x0A;合っているかは、重ねた表示 (速度・タイム) と映像を見比べて確かめます。ずれていたら下のボタンで少しずつ直せます。"/>
                        <Button Name="SyncButton" Content="このコマが選んだ周回の開始" Padding="8,4" FontWeight="Bold" Click="Sync_Click"/>
                        <TextBlock Name="SyncText" Margin="0,6,0,4" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
                        <TextBlock Text="表示を動画に対して動かす" Margin="0,2,0,2" FontSize="12"/>
                        <WrapPanel>
                            <Button Content="−1 秒" Tag="-1" Padding="6,2" Margin="0,0,4,4" Click="Nudge_Click"/>
                            <Button Content="−0.1" Tag="-0.1" Padding="6,2" Margin="0,0,4,4" Click="Nudge_Click"/>
                            <Button Content="−1 コマ" Tag="-f" Padding="6,2" Margin="0,0,4,4" Click="Nudge_Click"/>
                            <Button Content="＋1 コマ" Tag="f" Padding="6,2" Margin="0,0,4,4" Click="Nudge_Click"/>
                            <Button Content="＋0.1" Tag="0.1" Padding="6,2" Margin="0,0,4,4" Click="Nudge_Click"/>
                            <Button Content="＋1 秒" Tag="1" Padding="6,2" Margin="0,0,4,4" Click="Nudge_Click"/>
                        </WrapPanel>
                        <CheckBox Name="OverlayCheck" Content="動画素材と同じ表示を重ねる" IsChecked="True" Margin="0,4,0,0" Checked="Overlay_Changed" Unchecked="Overlay_Changed"/>
                        <CheckBox Name="GraphCheck" Content="速度のグラフ (焼き込みにも)" Margin="0,4,0,0"
                                  ToolTip="右下のセクター表示の上に、距離ごとの速度のグラフを出します。動画素材の書き出し・動画で比較と共通の設定です (どこかで変えるとほかの画面にも反映)"/>
                        <Button Name="EditLayoutButton" Content="表示の編集..." Padding="10,3" Margin="0,6,0,0" HorizontalAlignment="Left" Click="EditLayout_Click"
                                ToolTip="今のコマの上で、表示の要素の ON/OFF と位置、サブ動画の枠とトリミングを直します"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="エンジンの回転数・アクセル (音声から)" Margin="0,10,0,0">
                    <StackPanel Margin="4">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6"
                                   Text="時刻を合わせた動画の音声から、このセッションの回転数を求めて「ログ名.rpm.json」に保存します。カート (直結の 2 スト単気筒、KT100 など) は回転数 = 係数 × 速度 とアクセルの ON / OFF、変速機付きの車は音の線をたどった回転数とギア (車両のセットを選びます。ギア比などは解析結果の画面で直せます)。"/>
                        <DockPanel>
                            <TextBlock Text="車" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Name="VehicleCombo" VerticalAlignment="Center"
                                      ToolTip="カート、または変速機付きの車両のセット (ギア比・タイヤなど)。セットは解析結果の画面で直して保存できます"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Name="EngineButton" Content="音声を解析" Padding="12,4" Click="Engine_Click"
                                    ToolTip="解析が終わると、結果を確かめる図の画面が開きます (セッション 10 分で数十秒)"/>
                            <TextBlock Name="EngineText" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="サブ動画 (ペダルなど別のカメラ)" Margin="0,10,0,0">
                    <StackPanel Margin="4">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6"
                                   Text="走行動画に別のカメラの動画を小さく重ねます (再生ではサブの音声は使いません)。先に上で走行動画の時刻を合わせてから開いてください。ずれ・トリミングは変えるとすぐ「ログ名.log.json」に保存します。枠の位置・大きさはレイアウトの [subvideo] です。"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Name="SubOpenButton" Content="サブ動画を開く..." Padding="12,4" Click="SubOpen_Click"
                                    ToolTip="走行動画と同じ時間に撮った別のカメラの動画を選びます。はじめは「2 本が同時に録り始めた」として重ねます"/>
                            <Button Name="SubRemoveButton" Content="外す" Padding="8,4" Margin="6,0,0,0" Click="SubRemove_Click"
                                    ToolTip="このサブ動画の登録を外します (動画のファイルは消しません)"/>
                            <CheckBox Name="SubCheck" Content="重ねる" IsChecked="True" Margin="10,0,0,0" VerticalAlignment="Center" Click="SubCheck_Click"/>
                        </StackPanel>
                        <TextBlock Name="SubText" Margin="0,6,0,4" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
                        <Button Name="SubAudioButton" Content="音声で合わせる" Padding="10,3" HorizontalAlignment="Left" Margin="0,0,0,4" Click="SubAudio_Click"
                                    ToolTip="メインの今の位置の前後 60 秒の音声を、サブの今のずれの前後 5 分の中で探します (エンジン音などの大きさの変化の形で比べます)。&#x0A;合わなければ、エンジンの音がはっきりしている所 (走行中) に動かしてからもう一度押してください"/>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="候補" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Name="SubCandCombo" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12" SelectionChanged="SubCand_Changed"
                                      ToolTip="音声で合わせた候補 (相関の高い順)。選ぶとそのずれにします。&#x0A;際立ち = 山の高さが全体のばらつきの何倍か (10 以上ならまず確か。5 未満は疑わしい)"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="ずれ" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock DockPanel.Dock="Right" Text="秒" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <TextBox Name="SubOffsetBox" VerticalAlignment="Center" FontFamily="Consolas" KeyDown="SubBox_KeyDown" LostFocus="SubOffset_LostFocus"
                                     ToolTip="サブの時刻 = メインの時刻 + ずれ。サブが先に録り始めていれば正、後なら負&#x0A;入力して Enter で反映"/>
                        </DockPanel>
                        <TextBlock Text="サブ動画をメインに対して動かす" Margin="0,2,0,2" FontSize="12"/>
                        <WrapPanel>
                            <Button Content="−1 秒" Tag="-1" Padding="6,2" Margin="0,0,4,4" Click="SubNudge_Click"/>
                            <Button Content="−0.1" Tag="-0.1" Padding="6,2" Margin="0,0,4,4" Click="SubNudge_Click"/>
                            <Button Content="−1 コマ" Tag="-f" Padding="6,2" Margin="0,0,4,4" Click="SubNudge_Click" ToolTip="サブ動画の 1 コマ"/>
                            <Button Content="＋1 コマ" Tag="f" Padding="6,2" Margin="0,0,4,4" Click="SubNudge_Click" ToolTip="サブ動画の 1 コマ"/>
                            <Button Content="＋0.1" Tag="0.1" Padding="6,2" Margin="0,0,4,4" Click="SubNudge_Click"/>
                            <Button Content="＋1 秒" Tag="1" Padding="6,2" Margin="0,0,4,4" Click="SubNudge_Click"/>
                        </WrapPanel>
                        <TextBlock Text="トリミング (元の動画から切り落とす画素数。Enter で反映)" Margin="0,4,0,2" FontSize="12"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="左" VerticalAlignment="Center" Margin="0,0,3,0"/>
                            <TextBox Name="SubCropL" Width="48" Tag="0" FontFamily="Consolas" KeyDown="SubBox_KeyDown" LostFocus="SubCrop_LostFocus" MouseWheel="SubCrop_Wheel"/>
                            <TextBlock Text="上" VerticalAlignment="Center" Margin="8,0,3,0"/>
                            <TextBox Name="SubCropT" Width="48" Tag="1" FontFamily="Consolas" KeyDown="SubBox_KeyDown" LostFocus="SubCrop_LostFocus" MouseWheel="SubCrop_Wheel"/>
                            <TextBlock Text="右" VerticalAlignment="Center" Margin="8,0,3,0"/>
                            <TextBox Name="SubCropR" Width="48" Tag="2" FontFamily="Consolas" KeyDown="SubBox_KeyDown" LostFocus="SubCrop_LostFocus" MouseWheel="SubCrop_Wheel"/>
                            <TextBlock Text="下" VerticalAlignment="Center" Margin="8,0,3,0"/>
                            <TextBox Name="SubCropB" Width="48" Tag="3" FontFamily="Consolas" KeyDown="SubBox_KeyDown" LostFocus="SubCrop_LostFocus" MouseWheel="SubCrop_Wheel"
                                     ToolTip="マウスのホイールで 2 画素ずつ (Shift で 10) 増減"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="心拍 (腕時計などの FIT ファイルから)" Margin="0,10,0,0">
                    <StackPanel Margin="4">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6"
                                   Text="FIT ファイルの速度とログの速度を比べて時計のずれを求め、心拍の対応を「ログ名.log.json」に保存します (FIT はログのそばの heart フォルダにコピー)。保存すると、ドライバー名の右にハートと心拍数が出ます (無ければ出ません)。ずれは下のボタンで直せます。"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Name="FitButton" Content="FIT を開く..." Padding="12,4" Click="Fit_Click"
                                    ToolTip="このセッションのドライバーが着けていた腕時計などの FIT ファイルを選びます"/>
                            <Button Name="FitRemoveButton" Content="外す" Padding="8,4" Margin="6,0,0,0" Click="FitRemove_Click"
                                    ToolTip="このセッションの心拍を外します (表示しなくなります)"/>
                        </StackPanel>
                        <TextBlock Name="FitText" Margin="0,6,0,4" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="候補" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Name="FitCandCombo" VerticalAlignment="Center" SelectionChanged="FitCand_Changed"
                                      ToolTip="速度の形で合わせた候補 (相関の高い順)。周回ごとに似た形が繰り返すので、1 周ずれた所が候補に入ることがあります。&#x0A;「揃い」= 走った所を数分ごとに区切って合わせ直したとき、同じ所に揃った区間の数 (多いほど確か)"/>
                        </DockPanel>
                        <TextBlock Text="心拍を動画に対して動かす" Margin="0,2,0,2" FontSize="12"/>
                        <WrapPanel>
                            <Button Content="−1 秒" Tag="-1" Padding="6,2" Margin="0,0,4,4" Click="FitNudge_Click"/>
                            <Button Content="−0.1" Tag="-0.1" Padding="6,2" Margin="0,0,4,4" Click="FitNudge_Click"/>
                            <Button Content="＋0.1" Tag="0.1" Padding="6,2" Margin="0,0,4,4" Click="FitNudge_Click"/>
                            <Button Content="＋1 秒" Tag="1" Padding="6,2" Margin="0,0,4,4" Click="FitNudge_Click"/>
                            <Button Content="自動に戻す" Tag="auto" Padding="6,2" Margin="0,0,4,4" Click="FitNudge_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>
                <GroupBox Name="ClipGroup" Header="選んだ周回を切り出す" Margin="0,10,0,0">
                    <StackPanel Margin="4">
                        <WrapPanel>
                            <TextBlock Text="前" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox Name="BeforeBox" Width="44" Text="5" Margin="0,0,4,0"/>
                            <TextBlock Text="秒  後" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox Name="AfterBox" Width="44" Text="5" Margin="0,0,4,0"/>
                            <TextBlock Text="秒" VerticalAlignment="Center"/>
                        </WrapPanel>
                        <CheckBox Name="MergeCheck" Content="連続している周回を1つに結合" IsChecked="False" Margin="0,6,0,0"
                                  ToolTip="選んだ周回のうち、続いている周回 (例: L3・L4・L5) は 1 本にまとめ、間が空いた所で別の動画に分けます。前後の余白は、まとめた範囲の最初と最後にだけ付けます。外すと 1 周ずつ切り出します"/>
                        <CheckBox Name="AudioCheck" Content="音声も入れる" IsChecked="True" Margin="0,6,0,0"/>
                        <WrapPanel Margin="0,6,0,0">
                            <CheckBox Name="FadeCheck" Content="最初と最後をフェード" IsChecked="False" VerticalAlignment="Center" Margin="0,0,8,0"
                                      ToolTip="切り出した動画の最初を黒からのフェードイン、最後を黒へのフェードアウトにします。音声も同じ長さで、無音から大きく・無音へ小さくします。焼き込む表示やサブ動画も画面ごといっしょにフェードします"/>
                            <TextBox Name="FadeBox" Width="44" Text="1" Margin="0,0,4,0"/>
                            <TextBlock Text="秒" VerticalAlignment="Center"/>
                        </WrapPanel>
                        <CheckBox Name="BurnCheck" Content="速度・タイム・セクターを焼き込む" IsChecked="False" Margin="0,6,0,0"
                                  ToolTip="動画素材の書き出しと同じ表示 (同じレイアウトの設定) を映像に重ねて切り出します。サブ動画を開いていて「重ねる」が ON なら、サブ動画も同じ位置に入れます。表示は後から消せません。書き出しに時間がかかります。焼き込んだ動画は「動画で比較」には使いません (元の動画を使います)"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,6"
                                   Text="元の動画と同じフォルダに「元の名前_S6_L3.mp4」のように保存します (H.264、再エンコード)。切り出した動画も時刻合わせ済みとして登録するので、比較画面でそのまま使えます。焼き込むときは「元の名前_S6_L3_overlay.mp4」になります。まとめたときは「元の名前_S6_L3-L5.mp4」です。"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Name="ClipButton" Content="切り出す" Padding="12,4" FontWeight="Bold" Click="Clip_Click"/>
                            <Button Name="CancelButton" Content="中止" Padding="10,4" Margin="6,0,0,0" IsEnabled="False" Click="Cancel_Click"/>
                        </StackPanel>
                        <ProgressBar Name="Progress" Height="8" Margin="0,6,0,0" Maximum="1"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- 再生の操作 -->
        <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0">
            <Button Content="−10 秒" Tag="-10" Padding="8,4" Margin="0,0,4,4" Click="Step_Click"/>
            <Button Content="−1 秒" Tag="-1" Padding="8,4" Margin="0,0,4,4" Click="Step_Click"/>
            <Button Content="◀ コマ" Tag="-f" Padding="8,4" Margin="0,0,4,4" Click="Step_Click" ToolTip="1 コマ戻す (← キー)"/>
            <Button Name="PlayButton" Content="▶ 再生" Width="90" Padding="0,4" Margin="0,0,4,4" Click="Play_Click" ToolTip="再生・一時停止 (スペース キー)"/>
            <Button Content="コマ ▶" Tag="f" Padding="8,4" Margin="0,0,4,4" Click="Step_Click" ToolTip="1 コマ進める (→ キー)"/>
            <Button Content="＋1 秒" Tag="1" Padding="8,4" Margin="0,0,4,4" Click="Step_Click"/>
            <Button Content="＋10 秒" Tag="10" Padding="8,4" Margin="0,0,14,4" Click="Step_Click"/>
            <TextBlock Name="TimeText" VerticalAlignment="Center" FontFamily="Consolas" Margin="0,0,0,4"/>
        </WrapPanel>
        <DockPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,2,0,0">
            <TextBlock Name="StatusText" DockPanel.Dock="Bottom" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
            <Slider Name="TimeSlider" Minimum="0" Maximum="1" ValueChanged="Slider_Changed" IsMoveToPointEnabled="True"/>
        </DockPanel>
    </Grid>
</Window>
