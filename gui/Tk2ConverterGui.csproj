<Project Sdk="Microsoft.NET.Sdk">

  <!-- Wintec TK2 変換ツールの WPF 版。変換ロジックはコンソール版と同じ ..\tk2nmea.cs を共用する -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>WintecTK2Converter</AssemblyName>
    <RootNamespace>Tk2Gui</RootNamespace>
    <Title>Wintec TK2 変換ツール</Title>
    <Version>1.0.0</Version>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- tk2nmea.cs にも Main があるため、WPF 側の App を入口に指定する -->
    <StartupObject>Tk2Gui.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\tk2nmea.cs" Link="tk2nmea.cs" />
    <!-- 既定設定 (コンソール版と共通)。exe と同じフォルダにコピーされる -->
    <None Include="..\tk2nmea.ini" Link="tk2nmea.ini" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
