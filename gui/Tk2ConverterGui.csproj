<Project Sdk="Microsoft.NET.Sdk">

  <!-- Wintec TK2 変換ツールの WPF 版。変換ロジックはコンソール版と同じ ..\tk2nmea.cs を共用する -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>WintecTK2Converter</AssemblyName>
    <RootNamespace>Tk2Gui</RootNamespace>
    <Title>Wintec TK2 変換ツール</Title>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- tk2nmea.cs にも Main があるため、WPF 側の App を入口に指定する -->
    <StartupObject>Tk2Gui.App</StartupObject>
    <!-- アイコン (tools/make_icon.py で作る。exe とウィンドウの両方に使う) -->
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\tk2nmea.cs" Link="tk2nmea.cs" />
    <Resource Include="AppIcon.ico" />
    <!-- 既定設定 (コンソール版と共通)。exe と同じフォルダにコピーされる -->
    <None Include="..\tk2nmea.ini" Link="tk2nmea.ini" CopyToOutputDirectory="PreserveNewest" />
    <!-- 動画素材の既定のレイアウト -->
    <None Include="overlay_default.ini" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- バージョン: Major.Minor.Build はここを直接編集して手動で管理する。リビジョン (4 桁目) はビルドのたびに 1 つ増やす (revision.txt)。
       WPF の XAML コンパイル用の一時プロジェクト (*_wpftmp.csproj) でも走って二重に増えるため、本体のときだけ実行する -->
  <PropertyGroup>
    <VersionMajorMinorBuild>1.2.0</VersionMajorMinorBuild>
    <RevisionFile>$(MSBuildProjectDirectory)\revision.txt</RevisionFile>
  </PropertyGroup>

  <Target Name="IncrementRevision" BeforeTargets="BeforeBuild" Condition="!$(MSBuildProjectName.EndsWith('_wpftmp'))">
    <ReadLinesFromFile File="$(RevisionFile)" Condition="Exists('$(RevisionFile)')">
      <Output TaskParameter="Lines" ItemName="RevisionLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <CurrentRevision Condition="'@(RevisionLines)' != ''">@(RevisionLines)</CurrentRevision>
      <CurrentRevision Condition="'$(CurrentRevision)' == ''">0</CurrentRevision>
      <NewRevision>$([MSBuild]::Add($(CurrentRevision), 1))</NewRevision>
    </PropertyGroup>
    <WriteLinesToFile File="$(RevisionFile)" Lines="$(NewRevision)" Overwrite="true" />
    <PropertyGroup>
      <AssemblyVersion>$(VersionMajorMinorBuild).$(NewRevision)</AssemblyVersion>
      <FileVersion>$(VersionMajorMinorBuild).$(NewRevision)</FileVersion>
      <InformationalVersion>$(VersionMajorMinorBuild).$(NewRevision)</InformationalVersion>
    </PropertyGroup>
  </Target>

</Project>
