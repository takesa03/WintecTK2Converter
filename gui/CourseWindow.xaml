<Window x:Class="Tk2Gui.CourseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="コース定義の作成" Height="820" Width="1080" MinHeight="600" MinWidth="900"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="110"/>
        </Grid.RowDefinitions>

        <!-- 左: 入力と設定 -->
        <ScrollViewer Grid.Row="0" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
            <StackPanel>
                <GroupBox Header="走行ログ (.tk2 / .nmea)">
                    <StackPanel>
                        <ListBox Name="FileList" Height="90" SelectionMode="Extended"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="追加..." Click="AddFile_Click"/>
                            <Button Content="削除" Click="RemoveFile_Click"/>
                        </StackPanel>
                        <TextBlock Foreground="Gray" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="複数周回が入ったログを選びます。ドラッグ＆ドロップでも追加できます。周回が多いほど平均化の精度が上がります。"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="解析の設定">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="コース名" VerticalAlignment="Center" Margin="0,0,8,6"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Name="NameBox" Text="Rainbow Sports" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="1" Text="速度の下限 (km/h)" VerticalAlignment="Center" Margin="0,0,8,6"
                                   ToolTip="これより遅い点 (ピット・停止・低速でばらつきが大きい点) は使いません"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Name="MinSpeedBox" Text="18" Width="70" HorizontalAlignment="Left" Margin="0,0,0,6"
                                 ToolTip="これより遅い点 (ピット・停止・低速でばらつきが大きい点) は使いません"/>
                        <TextBlock Grid.Row="2" Text="周回の所要時間倍率" VerticalAlignment="Center" Margin="0,0,8,6"
                                   ToolTip="周回の所要時間の中央値のこの倍を超える周回 (ピットイン・スピン等) は使いません"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Name="LapRatioBox" Text="1.2" Width="70" HorizontalAlignment="Left" Margin="0,0,0,6"
                                 ToolTip="周回の所要時間の中央値のこの倍を超える周回 (ピットイン・スピン等) は使いません"/>
                        <Button Grid.Row="3" Grid.ColumnSpan="2" Name="AnalyzeButton" Content="解析する" FontWeight="Bold" Padding="20,8"
                                HorizontalAlignment="Left" Margin="0,4,0,0" Click="Analyze_Click"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="コントロールライン・セクター" Name="GateGroup" IsEnabled="False">
                    <StackPanel>
                        <ListBox Name="GateList" Height="112" SelectionChanged="GateList_SelectionChanged"/>
                        <TextBlock Foreground="Gray" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,4"
                                   Text="一覧で選んだラインだけを前後に動かせます (距離は中心線の始点から進行方向に測ります。+ で進行方向へ)。"/>
                        <DockPanel Margin="0,0,0,4">
                            <TextBox DockPanel.Dock="Right" Name="PosBox" Width="60" Margin="6,0,0,0" LostFocus="PosBox_LostFocus"
                                     ToolTip="選んだラインの位置 [m]"/>
                            <Slider Name="PosSlider" Minimum="0" Maximum="650" SmallChange="1" LargeChange="10"
                                    VerticalAlignment="Center" ValueChanged="PosSlider_ValueChanged"/>
                        </DockPanel>
                        <WrapPanel Margin="0,0,0,6">
                            <Button Content="−5 m" Click="Nudge_Click" Tag="-5" Padding="8,5" Margin="0,0,4,4"/>
                            <Button Content="−1 m" Click="Nudge_Click" Tag="-1" Padding="8,5" Margin="0,0,4,4"/>
                            <Button Content="+1 m" Click="Nudge_Click" Tag="1" Padding="8,5" Margin="0,0,4,4"/>
                            <Button Content="+5 m" Click="Nudge_Click" Tag="5" Padding="8,5" Margin="0,0,10,4"/>
                            <Button Content="自動位置に戻す" Click="AutoPos_Click" Margin="0,0,0,4"
                                    ToolTip="コントロールラインは自動で決めた位置、セクターはコントロールラインから等間隔の位置に戻します"/>
                        </WrapPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="セクター数" VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBox Name="SectorBox" Text="3" Width="40"/>
                                <Button Content="等間隔に配置し直す" Click="Regen_Click" Margin="8,0,0,0"
                                        ToolTip="セクターを指定の数だけ、コントロールラインから等間隔に置き直します (個別に動かした位置は失われます)"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="ラインの片側 (m)" VerticalAlignment="Center" Margin="0,0,8,0"
                                       ToolTip="ラインの長さ。GPS のばらつきがあるので、コース幅より広めにします"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Name="HalfWidthBox" Text="12" Width="50" HorizontalAlignment="Left"
                                     LostFocus="HalfWidth_LostFocus" ToolTip="ラインの長さ。GPS のばらつきがあるので、コース幅より広めにします"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="確認・保存" Name="OutGroup" IsEnabled="False">
                    <StackPanel>
                        <Button Content="Google Earth で重ねて確認" HorizontalAlignment="Left" Click="OpenEarth_Click" Margin="0,0,0,6"/>
                        <Button Content="このコースでラップ解析..." HorizontalAlignment="Left" Click="OpenLap_Click" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="コース定義を保存..." FontWeight="Bold" Click="Save_Click"/>
                        </StackPanel>
                        <TextBlock Foreground="Gray" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="保存すると、同じ名前の確認用 KML (Google Earth 用) も作ります。"/>
                    </StackPanel>
                </GroupBox>
                <Button Content="保存済みのコース定義を開く..." HorizontalAlignment="Left" Click="OpenDef_Click"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 右: プレビュー -->
        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Name="InfoText" Margin="0,0,0,6" TextWrapping="Wrap" Foreground="DarkGreen" FontWeight="Bold"
                       Text="走行ログを追加して「解析する」を押してください"/>
            <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Background="White" ClipToBounds="True">
                <Canvas Name="Preview" SizeChanged="Preview_SizeChanged"/>
            </Border>
        </Grid>

        <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Name="LogBox" IsReadOnly="True" Margin="0,8,0,0"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas, MS Gothic" FontSize="12"/>
    </Grid>
</Window>
