<Window x:Class="Tk2Gui.ReplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="周回の比較再生" Height="760" Width="1180" MinHeight="480" MinWidth="760"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI" FontSize="13">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- 操作 -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Name="PlayButton" Content="▶ 再生" Width="86" Padding="0,5" Margin="0,0,6,0" Click="Play_Click"/>
            <Button Content="⏮ 最初から" Padding="10,5" Margin="0,0,14,0" Click="Restart_Click"/>
            <TextBlock Text="速度" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Name="SpeedCombo" Width="80" SelectedIndex="3" Margin="0,0,14,0" SelectionChanged="Speed_Changed">
                <ComboBoxItem Content="0.1 ×" Tag="0.1"/>
                <ComboBoxItem Content="0.25 ×" Tag="0.25"/>
                <ComboBoxItem Content="0.5 ×" Tag="0.5"/>
                <ComboBoxItem Content="1 ×" Tag="1"/>
                <ComboBoxItem Content="2 ×" Tag="2"/>
                <ComboBoxItem Content="4 ×" Tag="4"/>
            </ComboBox>
            <CheckBox Name="LoopCheck" Content="繰り返す" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <CheckBox Name="TraceCheck" Content="軌跡を表示" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0" Checked="View_Changed" Unchecked="View_Changed"/>
            <CheckBox Name="LabelCheck" Content="名前を表示" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0" Checked="View_Changed" Unchecked="View_Changed"/>
            <TextBlock Text="基準" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Name="RefCombo" Width="230" SelectionChanged="Ref_Changed"/>
        </StackPanel>

        <!-- コースと走行 -->
        <Border Grid.Row="1" Grid.Column="0" Background="#1E2228" CornerRadius="4" ClipToBounds="True">
            <Canvas Name="MapCanvas" SizeChanged="Map_SizeChanged" ClipToBounds="True"/>
        </Border>

        <!-- 凡例 (名前・ラップ・速度・基準との差) -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" Width="400" Margin="10,0,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="62"/><ColumnDefinition Width="62"/><ColumnDefinition Width="62"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="周回" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="2" Text="ラップ" FontWeight="SemiBold" TextAlignment="Right"/>
                    <TextBlock Grid.Column="3" Text="速度" FontWeight="SemiBold" TextAlignment="Right"/>
                    <TextBlock Grid.Column="4" Text="差 (秒)" FontWeight="SemiBold" TextAlignment="Right"/>
                </Grid>
                <StackPanel Name="LegendPanel"/>
                <TextBlock Foreground="Gray" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"
                           Text="全員をコントロールラインの通過から同時に走らせます。差は、同じ地点 (周回の進み具合) に基準の周回が着いた時刻との差の目安です (＋ = 基準より遅れ、− = 基準より先)。周回の最後の差は、ラップタイムの差と一致します。"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 時間 -->
        <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0">
            <TextBlock Name="TimeText" DockPanel.Dock="Right" Width="120" TextAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" Text="0:00.0 / 0:00.0"/>
            <Slider Name="TimeSlider" Minimum="0" Maximum="1" ValueChanged="Slider_Changed" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
