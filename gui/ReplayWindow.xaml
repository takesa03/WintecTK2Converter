<Window x:Class="Tk2Gui.ReplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="周回の比較再生" Height="760" Width="1180" MinHeight="480" MinWidth="760"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI" FontSize="13" Icon="AppIcon.ico">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- 操作 -->
        <WrapPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,4">
            <Button Name="PlayButton" Content="▶ 再生" Width="86" Padding="0,5" Margin="0,0,6,4" Click="Play_Click"/>
            <Button Content="⏮ 最初から" Padding="10,5" Margin="0,0,14,4" Click="Restart_Click"/>
            <TextBlock Text="速度" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Name="SpeedCombo" Width="80" SelectedIndex="3" Margin="0,0,14,0" SelectionChanged="Speed_Changed">
                <ComboBoxItem Content="0.1 ×" Tag="0.1"/>
                <ComboBoxItem Content="0.25 ×" Tag="0.25"/>
                <ComboBoxItem Content="0.5 ×" Tag="0.5"/>
                <ComboBoxItem Content="1 ×" Tag="1"/>
                <ComboBoxItem Content="2 ×" Tag="2"/>
                <ComboBoxItem Content="4 ×" Tag="4"/>
            </ComboBox>
            <CheckBox Name="LoopCheck" Content="繰り返す" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <CheckBox Name="TraceCheck" Content="軌跡を表示" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0" Checked="View_Changed" Unchecked="View_Changed"/>
            <CheckBox Name="LabelCheck" Content="名前を表示" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0" Checked="View_Changed" Unchecked="View_Changed"/>
            <CheckBox Name="PhotoCheck" Content="航空写真" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0" Checked="Photo_Changed" Unchecked="Photo_Changed"
                      ToolTip="背景に国土地理院の航空写真 (地理院タイル) を表示します。インターネット接続が必要です (読み込んだ写真は保存して、次回から使います)"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="基準" VerticalAlignment="Center" Margin="0,0,6,4"/>
                <ComboBox Name="RefCombo" Width="210" Margin="0,0,14,4" SelectionChanged="Ref_Changed"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
            <TextBlock Text="表示" VerticalAlignment="Center" Margin="0,0,6,4"/>
            <ComboBox Name="ViewCombo" Width="180" SelectedIndex="0" Margin="0,0,6,4" SelectionChanged="ViewMode_Changed"
                      ToolTip="基準の周回の自車位置を中心に拡大すると、走行ラインの違いが見やすくなります">
                <ComboBoxItem Content="コース全体"/>
                <ComboBoxItem Content="基準の周回を中心に拡大"/>
            </ComboBox>
            <Button Name="ZoomInButton" Content="＋" Width="32" Padding="0,3" Margin="0,0,4,4" IsEnabled="False" Click="ZoomIn_Click" ToolTip="拡大 (マウスホイールでも変えられます)"/>
            <Button Name="ZoomOutButton" Content="－" Width="32" Padding="0,3" Margin="0,0,8,4" IsEnabled="False" Click="ZoomOut_Click" ToolTip="縮小"/>
            <TextBlock Name="ZoomText" VerticalAlignment="Center" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </WrapPanel>

        <!-- コースと走行 -->
        <Border Grid.Row="1" Grid.Column="0" Background="#1E2228" CornerRadius="4" ClipToBounds="True">
            <Grid>
                <Canvas Name="MapCanvas" SizeChanged="Map_SizeChanged" ClipToBounds="True" Background="Transparent" MouseWheel="Map_MouseWheel"/>
                <TextBlock Name="PhotoCredit" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,4" Padding="4,1" FontSize="11"
                           Foreground="White" Background="#80000000" IsHitTestVisible="False"
                           Text="出典: 国土地理院 (地理院タイル・全国最新写真 (シームレス))"/>
            </Grid>
        </Border>

        <!-- 凡例 (名前・ラップ・速度・基準との差) -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" Width="400" Margin="10,0,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="62"/><ColumnDefinition Width="62"/><ColumnDefinition Width="62"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="周回" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="2" Text="ラップ" FontWeight="SemiBold" TextAlignment="Right"/>
                    <TextBlock Grid.Column="3" Text="速度" FontWeight="SemiBold" TextAlignment="Right"/>
                    <TextBlock Grid.Column="4" Text="差 (秒)" FontWeight="SemiBold" TextAlignment="Right"/>
                </Grid>
                <StackPanel Name="LegendPanel"/>
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"
                           Text="全員をコントロールラインの通過から同時に走らせます。差は、同じ地点 (周回の進み具合) に基準の周回が着いた時刻との差の目安です (＋ = 基準より遅れ、− = 基準より先)。周回の最後の差は、ラップタイムの差と一致します。&#x0A;表示を「基準の周回を中心に拡大」にすると、基準の周回の自車位置を中心に追いかけて、走行ラインの違いを見られます (＋／－ またはマウスホイールで拡大率を変更)。"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 時間 -->
        <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0">
            <TextBlock Name="TimeText" DockPanel.Dock="Right" Width="120" TextAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" Text="0:00.0 / 0:00.0"/>
            <Slider Name="TimeSlider" Minimum="0" Maximum="1" ValueChanged="Slider_Changed" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
