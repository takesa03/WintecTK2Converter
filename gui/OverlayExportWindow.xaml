<Window x:Class="Tk2Gui.OverlayExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="動画素材の書き出し" Height="780" Width="1100" MinHeight="520" MinWidth="760"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI" FontSize="13" Icon="AppIcon.ico">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Name="SessionText" Grid.Row="0" FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="レイアウト" VerticalAlignment="Center" Margin="0,0,8,4"/>
            <TextBox Grid.Row="0" Grid.Column="1" Name="LayoutBox" Margin="0,0,6,4" LostFocus="Layout_LostFocus"/>
            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,4">
                <Button Content="参照..." Padding="10,2" Click="BrowseLayout_Click"/>
                <Button Content="読み直す" Padding="10,2" Margin="6,0,0,0" Click="ReloadLayout_Click"/>
            </StackPanel>

            <TextBlock Grid.Row="1" Text="ffmpeg" VerticalAlignment="Center" Margin="0,0,8,4"/>
            <TextBox Grid.Row="1" Grid.Column="1" Name="FfmpegBox" Margin="0,0,6,4" LostFocus="Ffmpeg_LostFocus"/>
            <Button Grid.Row="1" Grid.Column="2" Content="参照..." Padding="10,2" HorizontalAlignment="Left" Margin="0,0,0,4" Click="BrowseFfmpeg_Click"/>

            <WrapPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal">
                <TextBlock Text="大きさ" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Name="SizeCombo" Width="120" SelectedIndex="0" Margin="0,0,16,0" SelectionChanged="Option_Changed">
                    <ComboBoxItem Content="1920 x 1080" Tag="1920x1080"/>
                    <ComboBoxItem Content="2560 x 1440" Tag="2560x1440"/>
                    <ComboBoxItem Content="3840 x 2160" Tag="3840x2160"/>
                    <ComboBoxItem Content="1280 x 720" Tag="1280x720"/>
                </ComboBox>
                <TextBlock Text="フレームレート" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Name="FpsCombo" Width="80" Margin="0,0,16,0"/>
                <TextBlock Text="セッションの前" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Name="BeforeBox" Width="50" Text="10" Margin="0,0,4,0" LostFocus="Option_LostFocus"/>
                <TextBlock Text="秒 / 後" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Name="AfterBox" Width="50" Text="10" Margin="0,0,4,0" LostFocus="Option_LostFocus"/>
                <TextBlock Text="秒" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Text="形式" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Name="FormatCombo" Width="270" SelectedIndex="0">
                    <ComboBoxItem Content="ProRes 4444 (.mov, 透明付き)"/>
                    <ComboBoxItem Content="透明 PNG 連番 (フォルダ)"/>
                    <ComboBoxItem Content="QuickTime Animation (.mov, 透明付き・小さい)"/>
                </ComboBox>
            </WrapPanel>
        </Grid>

        <!-- プレビュー: 画面の大きさの枠 (市松模様) の中に重ねて、透明な部分と画面の端がわかるようにする -->
        <Viewbox Grid.Row="2" Stretch="Uniform">
            <Grid Name="PreviewFrame" Width="1920" Height="1080">
                <Grid.Background>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,48,48" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="#FF3A4A5A" Geometry="M0,0 H2 V2 H0Z"/>
                                <GeometryDrawing Brush="#FF33424F" Geometry="M0,0 H1 V1 H0Z M1,1 H2 V2 H1Z"/>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Grid.Background>
                <Image Name="PreviewImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
        </Viewbox>

        <DockPanel Grid.Row="3" Margin="0,6,0,0">
            <TextBlock DockPanel.Dock="Left" Text="プレビューの時刻" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock DockPanel.Dock="Right" Name="TimeText" Width="90" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <Slider Name="TimeSlider" VerticalAlignment="Center" ValueChanged="TimeSlider_ValueChanged"/>
        </DockPanel>

        <DockPanel Grid.Row="4" Margin="0,8,0,0">
            <Button DockPanel.Dock="Left" Name="ExportButton" Content="書き出す..." FontWeight="Bold" Padding="22,6" Click="Export_Click"/>
            <Button DockPanel.Dock="Left" Name="CancelButton" Content="中止" Padding="14,6" Margin="8,0,0,0" IsEnabled="False" Click="Cancel_Click"/>
            <Button DockPanel.Dock="Left" Name="PngButton" Content="この時刻を PNG で保存..." Padding="12,6" Margin="8,0,0,0" Click="SaveFrame_Click"/>
            <ProgressBar DockPanel.Dock="Left" Name="Progress" Width="200" Height="14" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
